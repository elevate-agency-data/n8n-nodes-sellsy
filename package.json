{
  "name": "n8n-nodes-sellsy",
  "version": "0.1.0",
  "description": "Node N8N to interact with Sellsy",
  "license": "MIT",
  "homepage": "https://github.com/agaudin-alt/n8n-nodes-sellsy",
  "keywords": [
    "n8n-community-node-package",
    "sellsy",
    "sellsy-node",
    "sellsy-n8n",
    "sellsy-n8n-node",
    "sellsy-n8n-node-package"
  ],
  "author": {
    "name": "elevate_agency",
    "email": "conseil@elevate-agency.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agaudin-alt/n8n-nodes-sellsy.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/SellsyOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Sellsy/Sellsy.node.js",
      "dist/nodes/Sellsy/SellsyTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
